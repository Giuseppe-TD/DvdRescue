<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Banco di prova del motore di recupero: gira su Windows e su Linux perché include
    tutto il progetto tranne l'interfaccia grafica.
    Il materiale di prova si genera con make-test-images.sh.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TestHarness</AssemblyName>
    <RootNamespace>TestHarness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\DVDRescue\**\*.cs" />
    <Compile Remove="..\..\src\DVDRescue\MainForm.cs" />
    <Compile Remove="..\..\src\DVDRescue\MainForm.Designer.cs" />
    <Compile Remove="..\..\src\DVDRescue\Program.cs" />
    <Compile Remove="..\..\src\DVDRescue\bin\**\*.cs" />
    <Compile Remove="..\..\src\DVDRescue\obj\**\*.cs" />
  </ItemGroup>

</Project>
