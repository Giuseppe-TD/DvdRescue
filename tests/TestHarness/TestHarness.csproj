<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Banco di prova della logica di recupero: gira su Windows e su Linux perché
    non tocca WinForms, solo i file di analisi disco e carving MPEG.
    Prima di eseguirlo genera le immagini di prova con make-test-images.sh.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TestHarness</AssemblyName>
    <RootNamespace>TestHarness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\DVDRescue\Model\Models.cs" />
    <Compile Include="..\..\src\DVDRescue\Native\NativeMethods.cs" />
    <Compile Include="..\..\src\DVDRescue\Native\AlignedBuffer.cs" />
    <Compile Include="..\..\src\DVDRescue\Native\OpticalDrive.cs" />
    <Compile Include="..\..\src\DVDRescue\Disc\ISectorSource.cs" />
    <Compile Include="..\..\src\DVDRescue\Disc\UdfReader.cs" />
    <Compile Include="..\..\src\DVDRescue\Disc\Iso9660Reader.cs" />
    <Compile Include="..\..\src\DVDRescue\Disc\DiscEngine.cs" />
    <Compile Include="..\..\src\DVDRescue\Media\MpegCarver.cs" />
    <Compile Include="..\..\src\DVDRescue\Media\FfmpegRunner.cs" />
    <Compile Include="..\..\src\DVDRescue\Media\FfmpegLocator.cs" />
  </ItemGroup>

</Project>
