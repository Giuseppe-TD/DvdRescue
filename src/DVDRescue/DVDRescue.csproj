<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- permette di compilare l'app Windows Desktop anche da Linux/CI non-Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>DVDRescue</AssemblyName>
    <RootNamespace>DVDRescue</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <Version>1.4.0</Version>
    <FileVersion>1.4.0.0</FileVersion>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <Product>DVDRescue</Product>
    <Company>Tastiere Digitali srls</Company>
    <Copyright>Copyright © Tastiere Digitali srls</Copyright>
    <Description>Recupero video da DVD non finalizzati (miniDVD, DVD-VR, DVD-Video) ed esportazione in MP4</Description>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="DVDRescue.app.ico" />
  </ItemGroup>

</Project>
